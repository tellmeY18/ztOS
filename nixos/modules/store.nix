{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.ztos;

  hardware =
    if cfg.hardware == "qemu" then
      "qemu"
    else if cfg.hardware == "starlte" then
      "starlte"
    else
      "";

  run = pkgs.runCommand "ztos-run" {
    nativeBuildInputs = [ pkgs.makeWrapper ];
  } ''
    install -Dm755 ${../scripts/ztos-run} $out/bin/ztos-run
    patchShebangs $out/bin
    wrapProgram $out/bin/ztos-run \
      --prefix PATH : ${lib.makeBinPath [ pkgs.nix pkgs.coreutils ]}
  '';

  store = pkgs.runCommand "ztos-store" {
    nativeBuildInputs = [ pkgs.makeWrapper ];
  } ''
    install -Dm755 ${../scripts/ztos-store} $out/bin/ztos-store
    patchShebangs $out/bin
    wrapProgram $out/bin/ztos-store \
      --prefix PATH : ${
        lib.makeBinPath [
          pkgs.nix
          pkgs.coreutils
          pkgs.gawk
          pkgs.gnugrep
          pkgs.gnused
          pkgs.jq
        ]
      } \
      --suffix PATH : /run/current-system/sw/bin
  '';

  storeGui = pkgs.callPackage ../packages/ztos-store-gui.nix { };

  initialFlake = pkgs.writeText "ztos-flake.nix" ''
    {
      inputs = {
        ztos.url = "path:${../..}";
        nixpkgs.follows = "ztos/nixpkgs";
      };

      outputs = { self, nixpkgs, ztos }: {
        nixosConfigurations.${config.networking.hostName} = nixpkgs.lib.nixosSystem {
          system = "${pkgs.stdenv.hostPlatform.system}";
          modules = [
            (ztos.outPath + "/nixos/configurations/${hardware}.nix")
            ./packages.nix
          ];
        };
      };
    }
  '';

  initialPackages = pkgs.writeText "ztos-packages.nix" ''
    # Generated by ztos-store. Use the Store app to change it.
    { pkgs, ... }:
    {
      environment.systemPackages = with pkgs; [ ];
    }
  '';
in
{
  config = lib.mkIf (cfg.enable && cfg.store.enable) {
    environment.systemPackages = [
      run
      store
      storeGui
    ];

    # ztMETRO scans these in addition to its built-in directories; a pinned app
    # is just a .desktop file that calls ztos-run.
    systemd.tmpfiles.rules = [
      "d /nix/var/nix/gcroots/ztos 0755 root root -"
      "d /nix/var/nix/gcroots/ztos/apps 0755 root root -"
      "d /var/lib/ztos/store 0755 root root -"
      "d /etc/nixos 0755 root root -"
    ];

    # The Store app is part of the normal user experience; installing from it
    # must not ask the person to type a password on a phone.
    security.sudo.extraRules = [
      {
        users = [ cfg.user ];
        commands = [
          {
            command = "/run/current-system/sw/bin/ztos-store install *";
            options = [ "NOPASSWD" ];
          }
          {
            command = "/run/current-system/sw/bin/ztos-store uninstall *";
            options = [ "NOPASSWD" ];
          }
        ];
      }
    ];

    # A fresh ztOS image has no /etc/nixos. The store is declarative, so first
    # boot writes a small flake that rebuilds the same hardware configuration
    # with ./packages.nix as one more module. The source is kept by a GC root.
    system.activationScripts.ztos-store-bootstrap = lib.mkIf (cfg.store.bootstrap && hardware != "") {
      text = ''
        install -d -m 0755 /nix/var/nix/gcroots/ztos /etc/nixos
        ln -sfn ${../..} /nix/var/nix/gcroots/ztos/source

        if [ ! -e /etc/nixos/flake.nix ]; then
          install -m 0644 ${initialFlake} /etc/nixos/flake.nix
        fi

        if [ ! -e /etc/nixos/packages.nix ]; then
          install -m 0644 ${initialPackages} /etc/nixos/packages.nix
        fi
      '';
    };
  };
}
