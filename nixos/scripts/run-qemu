#!/usr/bin/env bash
set -euo pipefail

bundle=${1:-./result}
if [ -d "$bundle" ]; then
	dir=$bundle
elif [ -f "$bundle" ]; then
	dir=$(dirname "$bundle")
else
	echo "usage: ztos-qemu /path/to/result-directory" >&2
	exit 1
fi

kernel=$dir/Image
initrd=$dir/initrd
rootfs=$dir/rootfs.img
for f in "$kernel" "$initrd" "$rootfs"; do
	[ -f "$f" ] || {
		echo "missing $f; run: nix build .#images.qemu" >&2
		exit 1
	}
done

qemu=$(command -v qemu-system-aarch64) || {
	echo "qemu-system-aarch64 is not in PATH; run this from nix develop" >&2
	exit 1
}

accel=tcg
cpu=max
case "$(uname -s)" in
Darwin)
	accel=hvf
	cpu=host
	;;
Linux)
	if [ -w /dev/kvm ]; then
		accel=kvm
		cpu=host
	fi
	;;
esac

exec "$qemu" \
	-machine virt,highmem=on \
	-cpu "$cpu" \
	-accel "$accel" \
	-smp 4 \
	-m 4096 \
	-kernel "$kernel" \
	-initrd "$initrd" \
	-append "root=/dev/vda rw rootfstype=ext4 console=ttyAMA0" \
	-drive "file=$rootfs,if=virtio,format=raw" \
	-device virtio-gpu-pci \
	-device qemu-xhci \
	-device usb-kbd \
	-device usb-tablet \
	-nic user,model=virtio-net-pci \
	-serial mon:stdio \
	-display "${ZTOS_QEMU_DISPLAY:-default}"
