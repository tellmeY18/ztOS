#!/usr/bin/env bash
# ztos-store: ztOS's package store. Nothing here uses a user profile.
#
# The normal path is declarative: "install" adds an attribute to the package
# list in the system flake and rebuilds the generation. "pin" is the temporary
# path: it builds one package, keeps it alive with a GC root, records the flake
# reference and writes a launcher that calls ztos-run.
set -euo pipefail

ROOT=/nix/var/nix/gcroots/ztos/apps
STATE=/var/lib/ztos/apps
DECL=/var/lib/ztos/store/system
PACKAGES=/etc/nixos/packages.nix
DESKTOP=/var/lib/ztos/share/applications

usage() {
  cat <<'EOF'
usage: ztos-store COMMAND

  search QUERY...     search nixpkgs
  install REF         add REF to the system and rebuild
  uninstall REF       remove REF from the system and rebuild
  installed [--json]  list the apps in the system
  pin REF             keep REF alive without adding it to the system
  remove NAME         remove a pinned app
  list                show pinned apps
  run REF [ARGS...]   run REF without pinning it
EOF
}

name_from_ref() {
  local ref=$1 attr name
  attr=${ref##*#}
  attr=${attr%%\[*}
  name=${attr##*.}
  name=${name//[^A-Za-z0-9._+-]/-}
  printf '%s\n' "${name:-app}"
}

normalize_ref() {
  local attr=$1
  attr=${attr##*#}
  attr=${attr#legacyPackages.*.}
  attr=${attr#packages.*.}
  printf '%s\n' "$attr"
}

check_attr() {
  local attr=$1
  case "$attr" in
    ''|.*|*.|*..*|*[!A-Za-z0-9._+-]*)
      echo "ztos-store: not a package attribute: '$attr'" >&2
      return 1
      ;;
    [A-Za-z0-9_]*)
      return 0
      ;;
    *)
      echo "ztos-store: not a package attribute: '$attr'" >&2
      return 1
      ;;
  esac
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ztos-store: this command changes the system; run it with sudo" >&2
    exit 1
  fi
}

write_packages() {
  local tmp
  tmp=$(mktemp "${PACKAGES}.XXXXXX")
  {
    echo "# Generated by ztos-store. Use the Store app to change it."
    echo "{ pkgs, ... }:"
    echo "{"
    echo "  environment.systemPackages = with pkgs; ["
    if [ -s "$DECL" ]; then
      sed 's/^/    /' "$DECL"
    fi
    echo "  ];"
    echo "}"
  } >"$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$PACKAGES"
}

rebuild() {
  if ! command -v ztos-update >/dev/null 2>&1; then
    echo "ztos-store: ztos-update is not installed; enable ztos.update" >&2
    return 1
  fi
  ztos-update apply
}

cmd_search() {
  exec nix search nixpkgs "$@"
}

cmd_install() {
  if [ "$#" -ne 1 ]; then
    echo "usage: ztos-store install REF" >&2
    exit 2
  fi
  require_root

  local attr
  attr=$(normalize_ref "$1")
  check_attr "$attr"

  install -d "$(dirname "$PACKAGES")" "$(dirname "$DECL")"
  touch "$DECL"

  if grep -Fxq "$attr" "$DECL"; then
    echo "$attr is already installed"
    return
  fi

  cp "$DECL" "$DECL.bak"
  printf '%s\n' "$attr" >>"$DECL"
  write_packages

  echo "Installing $attr..."
  if ! rebuild; then
    mv "$DECL.bak" "$DECL"
    write_packages
    echo "ztos-store: could not install $attr; the package list was restored" >&2
    exit 1
  fi
  rm -f "$DECL.bak"
  echo "Installed $attr"
}

cmd_uninstall() {
  if [ "$#" -ne 1 ]; then
    echo "usage: ztos-store uninstall REF" >&2
    exit 2
  fi
  require_root

  local attr
  attr=$(normalize_ref "$1")
  check_attr "$attr"

  if [ ! -f "$DECL" ] || ! grep -Fxq "$attr" "$DECL"; then
    echo "$attr is not installed" >&2
    exit 1
  fi

  cp "$DECL" "$DECL.bak"
  grep -Fxv "$attr" "$DECL" >"$DECL.new" || true
  mv "$DECL.new" "$DECL"
  write_packages

  echo "Removing $attr..."
  if ! rebuild; then
    mv "$DECL.bak" "$DECL"
    write_packages
    echo "ztos-store: could not remove $attr; the package list was restored" >&2
    exit 1
  fi
  rm -f "$DECL.bak"
  echo "Removed $attr"
}

cmd_installed() {
  if [ "${1:-}" = "--json" ]; then
    if [ -s "$DECL" ]; then
      jq -R -s 'split("\n") | map(select(length > 0))' "$DECL"
    else
      echo '[]'
    fi
    return
  fi

  if [ -s "$DECL" ]; then
    cat "$DECL"
  else
    echo "no apps installed"
  fi
}

cmd_pin() {
  if [ "$#" -ne 1 ]; then
    echo "usage: ztos-store pin REF" >&2
    exit 2
  fi
  require_root

  local ref=$1 name
  name=$(name_from_ref "$ref")

  install -d "$ROOT" "$STATE" "$DESKTOP"
  nix build --out-link "$ROOT/$name" "$ref"
  printf '%s\n' "$ref" >"$STATE/$name.ref"

  cat >"$DESKTOP/$name.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=Pinned by ztos-store
Exec=ztos-run $ref
TryExec=ztos-run
Terminal=false
Categories=System;
EOF

  echo "pinned $name -> $ref"
}

cmd_remove() {
  if [ "$#" -ne 1 ]; then
    echo "usage: ztos-store remove NAME" >&2
    exit 2
  fi
  require_root

  local name=$1
  rm -f "$ROOT/$name" "$STATE/$name.ref" "$DESKTOP/$name.desktop"
  echo "removed $name"
}

cmd_list() {
  local ref
  if ! compgen -G "$STATE/*.ref" >/dev/null; then
    echo "no pinned apps"
    return
  fi
  for ref in "$STATE"/*.ref; do
    printf '%-24s %s\n' "$(basename "$ref" .ref)" "$(cat "$ref")"
  done
}

cmd_run() {
  exec ztos-run "$@"
}

case "${1:-}" in
  search)
    shift
    cmd_search "$@"
    ;;
  install)
    shift
    cmd_install "$@"
    ;;
  uninstall)
    shift
    cmd_uninstall "$@"
    ;;
  installed)
    shift
    cmd_installed "$@"
    ;;
  pin)
    shift
    cmd_pin "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  list)
    cmd_list
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
